<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 零权限：不联网、不读取任何信息 -->

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.RegisterActivity" android:exported="false" />
        <activity android:name=".ui.SettingsActivity" android:exported="false" />
        <activity android:name=".ui.StudioActivity" android:exported="false" />
        <activity android:name=".ui.EditorActivity" android:exported="false" />
        <activity android:name=".ui.NodeEditActivity" android:exported="false" />
        <activity android:name=".ui.ScriptPickerActivity" android:exported="false" />
        <activity android:name=".ui.ChatActivity" android:exported="false" />
        <activity android:name=".ui.ReviewActivity" android:exported="false" />
        <activity android:name=".ui.SourcesActivity" android:exported="false" />

        <!-- 复盘分享海报：把 cache 里的图片以 content:// 提供给系统分享（免权限、不要 androidx） -->
        <provider
            android:name=".ui.PosterProvider"
            android:authorities="com.example.antifraud.poster"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- 桌面小组件：今日防骗贴士 -->
        <receiver
            android:name=".ui.TipsWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_tips_info" />
        </receiver>
    </application>

</manifest>

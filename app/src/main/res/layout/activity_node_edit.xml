<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.example.antifraud.ui.PTextView
                android:id="@+id/btn_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp"
                android:text="← 返回"
                android:textColor="@color/ink_secondary"
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.example.antifraud.ui.PTextView
                android:id="@+id/btn_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/px_button"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:text="保存节点"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>

        <com.example.antifraud.ui.PTextView
            android:id="@+id/tv_node"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="节点"
            android:textColor="@color/ink"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/et_speaker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/px_input"
            android:hint="说话人（如：卖家 / 平台客服）"
            android:inputType="text"
            android:padding="11dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink_hint"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/et_messages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/px_input"
            android:gravity="top"
            android:hint="台词：一行一条消息，空行自动忽略"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:padding="11dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink_hint"
            android:textSize="12sp" />

        <CheckBox
            android:id="@+id/cb_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="这是结局节点"
            android:textColor="@color/ink"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/et_ending_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/px_input"
            android:hint="结局标题（结局节点才填）"
            android:inputType="text"
            android:padding="11dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink_hint"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/et_ending_advice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/px_input"
            android:gravity="top"
            android:hint="结局点评：这一步错在哪 / 正确做法"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:padding="11dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink_hint"
            android:textSize="12sp" />

        <com.example.antifraud.ui.PTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="选项（剧情节点最多 3 个）"
            android:textColor="@color/ink"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/ll_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <com.example.antifraud.ui.PTextView
            android:id="@+id/btn_delete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/px_option"
            android:gravity="center"
            android:padding="12dp"
            android:text="删除这个节点"
            android:textColor="@color/warn_red"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>

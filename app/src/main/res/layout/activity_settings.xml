<?xml version="1.0" encoding="utf-8"?>
<!--
    设置页布局（SettingsActivity 使用）：字体、字号等偏好设置，只在本机保存。

    结构：
      顶部一行是"← 返回"（btn_back）；
      下面 ll_root 是一个空容器，SettingsActivity 会在里面按顺序动态添加
      两张卡片：①"字体样式"（像素字体 / 系统字体）②"字号大小"
      （标准 1.0 / 大 1.3 / 特大 1.7 / 超大 2.1 四档，用 FlowLayout 自动折行）。

    为什么要动态生成：字号档位和可选项数量由 SettingsStore 的 SCALE_ 常量决定，
    写死在 XML 里以后加档位就得同时改 Java 和布局，容易漏。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 顶部返回行：只有一个按钮，用横向 LinearLayout 包一层是为了让按钮靠左 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.example.antifraud.ui.PTextView
                android:id="@+id/btn_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp"
                android:text="← 返回"
                android:textColor="@color/ink_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 设置项容器：字号档位卡片等全部由 SettingsActivity 动态添加到这里。
             这些卡片里的高度都用 SettingsStore.scaleBox 放大，保证超大字号下不挤字。 -->
        <LinearLayout
            android:id="@+id/ll_root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>

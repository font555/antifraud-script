<?xml version="1.0" encoding="utf-8"?>
<!--
    剧本工坊布局（StudioActivity 使用）：一个"自己写剧本、导出分享"的页面。
    这是作品的第二个创新点——不只让玩家读，还能自己造一个反诈剧本。

    整体结构（外层 ScrollView + 竖直 LinearLayout）：
      1. 顶部只有"← 返回"
      2. 标题"剧本工坊" + 一句说明
      3. 两个并排按钮：新建剧本 / 导入剧本文件（各占一半宽度）
      4. "我的剧本"小标题 + 剧本卡片列表 ll_list（动态生成）
      5. 空状态提示 tv_empty（没有自制剧本时才显示）
      6. 底部说明：剧本存在本机、导出是 .json 可以发微信/QQ

    注意：本页所有操作都是本地文件读写，不联网、不要存储权限。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fillViewport="true">

    <!-- 页面总容器 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 顶部返回行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.example.antifraud.ui.PTextView
                android:id="@+id/btn_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp"
                android:text="← 返回"
                android:textColor="@color/ink_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 页面大标题 -->
        <com.example.antifraud.ui.PTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="剧本工坊"
            android:textColor="@color/ink"
            android:textSize="22sp" />

        <!-- 一句功能说明 -->
        <com.example.antifraud.ui.PTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="自己写一个剧本，导出成文件，同学导入就能玩"
            android:textColor="@color/ink_secondary"
            android:textSize="10sp" />

        <!-- 并排操作行：两个按钮宽 0dp + weight=1 平分整行宽度，
             中间的 marginEnd/marginStart 各 5dp 形成 10dp 的间隙 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <!-- 主操作：新建一个空白剧本，跳到编辑页 -->
            <com.example.antifraud.ui.PTextView
                android:id="@+id/btn_new"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/px_button"
                android:gravity="center"
                android:padding="13dp"
                android:text="＋ 新建剧本"
                android:textColor="@color/white"
                android:textSize="13sp" />

            <!-- 次操作：从系统文件选择器挑一个 .json 剧本导入 -->
            <com.example.antifraud.ui.PTextView
                android:id="@+id/btn_import"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/px_option"
                android:gravity="center"
                android:padding="13dp"
                android:text="导入剧本文件"
                android:textColor="@color/ink"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 小标题：我的剧本列表 -->
        <com.example.antifraud.ui.PTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="我的剧本"
            android:textColor="@color/ink"
            android:textSize="13sp" />

        <!-- 自制剧本卡片容器：每张卡片三层——标题 → 副标题（分类 · 节点数 · 起始节点）
             → 三个操作按钮（编辑 / 导出 / 删除）。删除会弹二次确认，
             导出先拉起系统"保存到哪儿"的界面、在回调里才真正写文件。
             整列由 StudioActivity 动态生成。 -->
        <LinearLayout
            android:id="@+id/ll_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />

        <!-- 空状态：一个自制剧本都没有时显示，引导用户点"新建剧本" -->
        <com.example.antifraud.ui.PTextView
            android:id="@+id/tv_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="还没有自己的剧本。\n点「新建剧本」写第一个吧。"
            android:textColor="@color/ink_hint"
            android:textSize="10sp" />

        <!-- 底部说明：隐私与导出格式，直接回应评委可能问的"数据去哪了" -->
        <com.example.antifraud.ui.PTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="剧本存在本机，不联网、不上传、不需要任何权限\n导出后是一个 .json 文件，可以发微信/QQ 给同学"
            android:textColor="@color/ink_hint"
            android:textSize="9sp" />
    </LinearLayout>
</ScrollView>

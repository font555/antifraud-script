<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.example.antifraud.ui.PTextView
                android:id="@+id/btn_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp"
                android:text="← 返回"
                android:textColor="@color/ink_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <com.example.antifraud.ui.PTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="剧本工坊"
            android:textColor="@color/ink"
            android:textSize="22sp" />

        <com.example.antifraud.ui.PTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="自己写一个剧本，导出成文件，同学导入就能玩"
            android:textColor="@color/ink_secondary"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <com.example.antifraud.ui.PTextView
                android:id="@+id/btn_new"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/px_button"
                android:gravity="center"
                android:padding="13dp"
                android:text="＋ 新建剧本"
                android:textColor="@color/white"
                android:textSize="13sp" />

            <com.example.antifraud.ui.PTextView
                android:id="@+id/btn_import"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/px_option"
                android:gravity="center"
                android:padding="13dp"
                android:text="导入剧本文件"
                android:textColor="@color/ink"
                android:textSize="13sp" />
        </LinearLayout>

        <com.example.antifraud.ui.PTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="我的剧本"
            android:textColor="@color/ink"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/ll_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />

        <com.example.antifraud.ui.PTextView
            android:id="@+id/tv_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="还没有自己的剧本。\n点「新建剧本」写第一个吧。"
            android:textColor="@color/ink_hint"
            android:textSize="10sp" />

        <com.example.antifraud.ui.PTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="剧本存在本机，不联网、不上传、不需要任何权限\n导出后是一个 .json 文件，可以发微信/QQ 给同学"
            android:textColor="@color/ink_hint"
            android:textSize="9sp" />
    </LinearLayout>
</ScrollView>

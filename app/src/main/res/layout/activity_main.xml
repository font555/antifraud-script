<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 顶部：返回 + 设置 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.example.antifraud.ui.PTextView
                android:id="@+id/btn_back_home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="2dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp"
                android:text="← 返回"
                android:textColor="@color/ink_secondary"
                android:textSize="14sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.example.antifraud.ui.PTextView
                android:id="@+id/btn_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="14dp"
                android:paddingTop="2dp"
                android:paddingBottom="10dp"
                android:text="设置 ⚙"
                android:textColor="@color/ink_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 顶部：头像 + 昵称 + 累计损失 -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/px_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <com.example.antifraud.ui.PTextView
                android:id="@+id/tv_avatar"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/px_button"
                android:gravity="center"
                android:text="生"
                android:textColor="@color/white"
                android:textSize="24sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.example.antifraud.ui.PTextView
                    android:id="@+id/tv_hello"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="同学，你好"
                    android:textColor="@color/ink"
                    android:textSize="18sp" />

                <com.example.antifraud.ui.PTextView
                    android:id="@+id/tv_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="反诈书库 · 已读 0 本"
                    android:textColor="@color/ink_hint"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <com.example.antifraud.ui.PTextView
                    android:id="@+id/tv_loss"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="损失 ¥0"
                    android:textColor="@color/warn_red"
                    android:textSize="13sp" />

                <com.example.antifraud.ui.PTextView
                    android:id="@+id/tv_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="本地存档"
                    android:textColor="@color/ink_hint"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 标题 -->
        <com.example.antifraud.ui.PTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="反诈书架"
            android:textColor="@color/ink"
            android:textSize="26sp" />

        <com.example.antifraud.ui.PTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="点开一本书，走进一个真实的骗局"
            android:textColor="@color/ink_secondary"
            android:textSize="13sp" />

        <!-- 书架 -->
        <LinearLayout
            android:id="@+id/ll_shelf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical" />

        <!-- 书架下方补充区：读书笔记 + 每日贴士 -->
        <LinearLayout
            android:id="@+id/ll_extra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

        <!-- 底部入口 -->
        <com.example.antifraud.ui.PTextView
            android:id="@+id/btn_all_sources"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/px_option"
            android:gravity="center"
            android:padding="14dp"
            android:text="查看全部真实案例来源"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <com.example.antifraud.ui.PTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="零权限 · 不联网 · 不收集个人信息\n本作品为教学演示，案例据公开报道改编"
            android:textColor="@color/ink_hint"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>

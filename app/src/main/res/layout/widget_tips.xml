<?xml version="1.0" encoding="utf-8"?>
<!--
    桌面小组件布局：标题 + 一条随机防骗贴士 + 已读/累计损失。
    注意：RemoteViews 只支持有限控件，这里全部用系统 TextView / LinearLayout，
    不能使用项目里的 PTextView（自定义 View 在桌面进程里无法 inflate）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/px_panel"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- 标题 -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="反诈书库"
        android:textColor="@color/ink"
        android:textSize="14sp" />

    <!-- 随机防骗贴士 -->
    <!-- 每次刷新随机换一条（数据来自 Tips.TIPS 数组），maxLines="3" 是硬上限：
         贴士再长也只显示三行，超出部分省略号，避免把小尺寸组件撑破。 -->
    <TextView
        android:id="@+id/tv_tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:lineSpacingExtra="3dp"
        android:maxLines="3"
        android:text="今日防骗贴士加载中…"
        android:textColor="@color/ink_secondary"
        android:textSize="12sp" />

    <!-- 本机读书战绩：已读本数 + 累计损失 -->
    <!-- 这一行不是静态文案：TipsWidgetProvider.onUpdate 每次刷新都会用
         setTextViewText 写入"已读 N 本 · 累计损失 ¥X"，N 和 X 来自 UserStore。 -->
    <TextView
        android:id="@+id/tv_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:text="已读 0 本 · 累计损失 ¥0"
        android:textColor="@color/ink_hint"
        android:textSize="10sp" />
    <!-- 补充：以上三条文字的文案都会在刷新时被 TipsWidgetProvider 覆写；
         tv_stats 用 maxLines="1" 是为了防止长文案把小尺寸组件撑破。 -->
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:id="@+id/card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/px_panel"
            android:orientation="vertical"
            android:padding="20dp">

            <com.example.antifraud.ui.PTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="反诈书库"
                android:textColor="@color/brand"
                android:textSize="31sp" />

            <com.example.antifraud.ui.PTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="给自己起个名字吧，读书进度会记在这台手机上。"
                android:textColor="@color/ink_secondary"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/et_nick"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/px_input"
                android:hint="昵称（2-8 个字）"
                android:inputType="text"
                android:maxLength="8"
                android:padding="12dp"
                android:textColor="@color/ink"
                android:textColorHint="@color/ink_hint"
                android:textSize="18sp" />

            <com.example.antifraud.ui.PTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="选一个头像"
                android:textColor="@color/ink_secondary"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/ll_avatars"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal" />

            <com.example.antifraud.ui.PTextView
                android:id="@+id/btn_enter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/px_button"
                android:gravity="center"
                android:padding="15dp"
                android:text="进入书库"
                android:textColor="@color/white"
                android:textSize="19sp" />

            <com.example.antifraud.ui.PTextView
                android:id="@+id/btn_skip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:padding="8dp"
                android:text="先随便逛逛"
                android:textColor="@color/ink_hint"
                android:textSize="13sp" />

            <com.example.antifraud.ui.PTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="昵称和头像只保存在本机\n不联网 · 不上传 · 零权限"
                android:textColor="@color/ink_hint"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
